# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
DATABASE_ENGINE=postgresql

# Database Configuration (Railway/Render will provide these automatically)
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=postgres.railway.internal
DB_PORT=5432

# Allowed Hosts (update with your deployment domains)
ALLOWED_HOSTS=localhost,127.0.0.1,*.railway.app,*.render.com

# CORS Settings (update with your frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend.railway.app,http://localhost:3000
